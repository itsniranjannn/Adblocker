{
  "manifest_version": 3,
  "name": "LiteBlock",
  "version": "3.0.0",
  "description": "Lightweight ad, popup and popunder blocker. No timers, no DOM scanning.",
  "minimum_chrome_version": "111",
  "permissions": ["declarativeNetRequest", "storage", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "declarative_net_request": {
    "rule_resources": [{ "id": "ads", "enabled": true, "path": "rules/ads.json" }]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shield.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["site.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "css": ["cosmetic.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["yt.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "LiteBlock" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
